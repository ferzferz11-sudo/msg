# Lavender Messenger — Hermes Agent Platform Adapter Configuration
# Скопируйте в .env и заполните значения

# ═══════════════════════════════════════════
# Lavender Server
# ═══════════════════════════════════════════

# Адрес gRPC-сервера Lavender
LAVENDER_SERVER=localhost:50052

# Ваш UUID user_id (берётся из базы данных или /whoami на сервере)
LAVENDER_USER_ID=

# Имя пользователя для отображения в чате
LAVENDER_USERNAME=hermes-agent

# Начальная задержка переподключения (секунды, экспоненциальный backoff)
LAVENDER_RECONNECT_DELAY=3.0

# Путь к директории с messenger.proto и сгенерированными pb2 файлами
# По умолчанию: текущая директория плагина
# LAVENDER_PROTO_DIR=/root/msg/hermes-agent

# ═══════════════════════════════════════════
# Hermes Agent (опционально)
# ═══════════════════════════════════════════

# Модель для AI-ответов (если адаптер вызывает ChatWithAI)
# HERMES_MODEL=openrouter/auto

# API ключ (если используется кастомный)
# HERMES_API_KEY=
