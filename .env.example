# Lavender Messenger

# --- server configuration ---
SERVER_ADDRESS=0.0.0.0:50051

# --- security ---
# Key must be exactly 32 characters for AES-256
CHAT_SECRET_KEY=CHANGE_ME_TO_RANDOM_32_CHARS!!

# --- database ---
# Production: use sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Local development
# DATABASE_URL=postgres://lavender:PASSWORD@localhost:5432/chat_db?sslmode=disable

# --- http servers ---
HTTP_PORT=8082
APK_PORT=8081
APK_DIR=/path/to/android/apk/dir

# --- OpenRouter AI ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/owl-alpha

# --- Reve Image Generation ---
# REVE_API_KEY=rv_xxxxxxxxxxxx

# --- Firebase ---
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-adminsdk.json

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- JWT ---
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_CHARS_OR_MORE!!

# --- Qdrant RAG (optional) ---
# QDRANT_URL=http://localhost:6333
# OPENAI_API_KEY=sk-...
